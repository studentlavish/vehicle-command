# Connects this agent to the backend running on this Mac
VASHU_AGENT_WS_URL=ws://localhost:8001/api/agent/ws
VASHU_AGENT_ID=local-mac-01
# The secret shown once when the agent was registered in Settings → Camera agents
VASHU_AGENT_SECRET=

# Camera: 0 = built-in/USB webcam, or http://<phone-ip>:8080/video, or rtsp://...
CAMERA_ID=CAM-01
CAMERA_NAME=Mac Camera
CAMERA_SOURCE=0

FRAME_WIDTH=960
FRAME_HEIGHT=540
AGENT_FPS=8
JPEG_QUALITY=55

# Set true after running ./install_ocr.sh (free, offline plate recognition)
ENABLE_LOCAL_DETECTION=false
# Plate detection frames per second per camera (drops automatically on a slow PC)
DETECTION_FPS=5

# --- Plate reading accuracy ---
# Readers: auto = fast-plate-ocr, with Awiros (Indian plates) consulted when unsure.
# OCR_ENGINE=awiros makes Awiros read every plate (slower).
OCR_ENGINE=auto
OCR_ENSEMBLE=true
PLATE_DETECTOR_CONF=0.35
VOTE_MIN_READS=3            # reads that must be collected before a plate is accepted
VOTE_AGREEMENT=0.6          # share of reads that must agree for "medium" confidence
CONFIRM_WINDOW_SECONDS=15   # max time to collect reads for one vehicle
REPEAT_SUPPRESS_SECONDS=120 # don't re-send the same plate from the same camera within this time

# Optional error tracking (needs: pip install sentry-sdk)
SENTRY_DSN=
