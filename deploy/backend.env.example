# Copy to deploy/backend.env — the backend's settings in production.
# MONGO_URL, PUBLIC_URL, CORS_ORIGINS and COOKIE_SECURE are set by docker-compose.yml.

DB_NAME=vehicle_command
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# First admin, created only when the database is empty (≥ 10 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_TIMEZONE=Asia/Kolkata

# ---- Storage for snapshots and backups ----
# s3 strongly recommended: backups on the same server don't survive losing the server.
STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=ap-south-1
# Only for Cloudflare R2 / MinIO / other S3-compatible services:
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=vehicle-command

# ---- Daily jobs (local time) ----
DIGEST_TIME=09:00
BACKUP_TIME=03:00
RETENTION_TIME=03:30
BACKUP_KEEP=14

# ---- Email (daily digest, alerts) ----
# resend | smtp | (empty = off)
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_FROM_NAME=Vashu Hyundai
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=starttls

# ---- Sign in with Google (optional) ----
# Redirect URI to register in Google Cloud: https://<DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- WhatsApp (optional, Meta Cloud API) ----
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=

# ---- Gate behaviour ----
REVIEW_MODE=strict
MIN_VISIT_SECONDS=120
MAX_VISIT_HOURS=24
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---- Old Emergent store (only while migrating old snapshots, then remove) ----
EMERGENT_LLM_KEY=

# ---- Alerts & monitoring ----
ALERT_EMAILS=
ALERT_WHATSAPP_TO=
LOG_FORMAT=json
SENTRY_DSN=
