# ---- Required ----
MONGO_URL="mongodb://localhost:27017"
DB_NAME="vehicle_command"
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=""
# First admin — used ONLY on a fresh install (empty database). After that,
# change passwords in the app; restarts never reset them.
# ADMIN_PASSWORD must be at least 10 characters and not a common password.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
# Exact dashboard URL(s), comma-separated. "*" is refused.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Keep true in production (HTTPS). Set false only for local http:// development.
COOKIE_SECURE="true"
COOKIE_SAMESITE="lax"

# ---- Camera agents ----
# Register each agent in Settings → Camera agents (or POST /api/agent/register);
# each one gets its own secret. This shared secret is only for agents registered
# before per-agent secrets existed — leave blank on new installs.
VASHU_AGENT_SECRET=""
# Local development only: pre-register this agent ID (it uses the shared secret
# above). Leave blank in production and register agents in Settings instead.
AGENT_BOOTSTRAP_ID=""

# ---- Daily jobs (built-in scheduler, local time) ----
SCHEDULER_ENABLED="true"
DIGEST_TIME="09:00"
BACKUP_TIME="03:00"
RETENTION_TIME="03:30"
# Optional: also allow an external cron to call /api/cron/digest and /api/cron/backup.
WEBHOOK_CRON_SECRET=""

# ---- Storage for snapshots and backups ----
# local (this machine's disk) or s3 (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_BACKEND="local"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX="vehicle-command"

# ---- Email (daily digest, alerts): resend | smtp | empty = off ----
EMAIL_PROVIDER=""
EMAIL_FROM=""
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS="starttls"

# ---- Sign in with Google (works when dashboard and API share one address) ----
PUBLIC_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Optional integrations (leave blank to disable) ----
# Old Emergent store — only to read / migrate snapshots from the old deployment.
EMERGENT_LLM_KEY=""
EMAIL_FROM_NAME="Vashu Hyundai"
EMAIL_REPLY_TO=""
GOOGLE_ADMIN_EMAIL=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_TO=""
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WABA_ID=""
META_VERIFY_TOKEN=""
META_APP_SECRET=""

# ---- Tuning ----
RETENTION_ENABLED="true"
SNAPSHOT_MIN_FREE_MB="500"
BACKUP_KEEP="7"

# ---- Safety & accuracy ----
# Failed sign-ins (per email + IP) before a temporary lock, and lock length.
LOGIN_MAX_FAILURES="5"
LOGIN_LOCK_MINUTES="15"
# Day boundaries for "today", reports and visit dates.
APP_TIMEZONE="Asia/Kolkata"
# A car must be inside at least this long before the same plate counts as an EXIT.
MIN_VISIT_SECONDS="120"
# Open visits older than this are flagged on the dashboard and in the digest.
MAX_VISIT_HOURS="24"
# strict  = auto-save only high-confidence reads (or medium for known vehicles); the rest go to Plate Review
# relaxed = auto-save high and medium; off = save every valid read (no review)
REVIEW_MODE="strict"

# ---- Alerts & monitoring ----
# Sent by email (EMAIL_PROVIDER) and WhatsApp (Meta) when configured; always shown on the dashboard.
ALERTS_ENABLED="true"
# Default: every admin. Comma-separated to override.
ALERT_EMAILS=""
# Default: the "Admin WhatsApp To" number in Settings.
ALERT_WHATSAPP_TO=""
ALERT_REPEAT_HOURS="6"
CAMERA_OFFLINE_SECONDS="120"
AGENT_OFFLINE_SECONDS="120"
ALERT_OUTBOX_DEPTH="20"
ALERT_REVIEW_PENDING="10"
ALERT_REVIEW_AGE_MINUTES="60"
BACKUP_MAX_AGE_HOURS="36"
# json = one JSON object per log line (for log collectors)
LOG_FORMAT=""
# Optional error tracking (sentry.io free tier)
SENTRY_DSN=""
